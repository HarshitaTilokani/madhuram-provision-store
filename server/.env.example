NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb://127.0.0.1:27017/madhuram_provision_store

JWT_ACCESS_SECRET=change_this_to_a_long_random_string_at_least_32_chars
JWT_REFRESH_SECRET=change_this_to_another_long_random_string_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary (required for product images in production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (Indian payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (optional for password reset / order emails)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM="Madhuram Provision Store <noreply@example.com>"

# Store configuration (real values supplied where known)
STORE_NAME=Madhuram Provision Store
STORE_TAGLINE=Your trusted neighbourhood kirana store in Beawar
STORE_ADDRESS=Bhagat Chauraya, Beawar, Rajasthan
STORE_CITY=Beawar
STORE_STATE=Rajasthan
STORE_PINCODE=305901
STORE_PHONE_PRIMARY=+91 9462498113
STORE_PHONE_SECONDARY=+91 9414259167
STORE_EMAIL=madhuramprovisionstore@gmail.com
STORE_GSTIN=[ADD GSTIN IF AVAILABLE]
STORE_HOURS=8:00 AM - 9:00 PM
OWNER_1=Raju Jeswani
OWNER_2=Tulsi Jeswani
MINIMUM_ORDER_VALUE=0
DELIVERY_FEE=0
FREE_DELIVERY_THRESHOLD=0
